{'author': 'Robert Sander <r.sander@heinlein-support.de>',
 'description': 'This package contains an agent plugin that can be installed '
                'on Proxmox nodes.\n'
                '\n'
                'It will output an agent data section compatible with the '
                'esx_vsphere_datastores check plugin. It computes provisioned '
                'and used storage space based on disk usage of qcow2 files.\n',
 'download_url': 'https://github.com/HeinleinSupport/check_mk_extensions/',
 'files': {'agents': ['plugins/proxmox_provisioned'],
           'cmk_addons_plugins': ['proxmox_provisioned/rulesets/proxmox_provisioned_cee.py'],
           'lib': ['python3/cmk/base/cee/plugins/bakery/proxmox_provisioned.py']},
 'name': 'proxmox_provisioned',
 'title': 'Proxmox Provisioned Storage Space',
 'version': '2.1.0',
 'version.min_required': '2.3.0b1',
 'version.packaged': '2.5.0p9',
 'version.usable_until': None}
