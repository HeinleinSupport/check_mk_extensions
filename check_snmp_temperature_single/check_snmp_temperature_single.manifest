{'author': 'Robert Sander <r.sander@heinlein-support.de>',
 'description': 'This is a ruleset for the Nagios plugin '
                'check_snmp_temperature.pl to create single Temperature '
                'checks\n'
                '\n'
                'The Perl based Nagios plugin needs Net::SNMP.\n'
                '\n'
                'On Debian this is available in the package '
                'libnet-snmp-perl.\n',
 'download_url': 'https://github.com/HienleinSupport/check_mk_extensions/',
 'files': {'cmk_addons_plugins': ['check_snmp_temperature_single/rulesets/check_snmp_temperature_single.py',
                                  'check_snmp_temperature_single/server_side_calls/check_snmp_temperature_single.py'],
           'lib': ['nagios/plugins/check_snmp_temperature.pl']},
 'name': 'check_snmp_temperature_single',
 'title': 'Check SNMP single Temperature',
 'version': '1.0.0',
 'version.min_required': '2.3.0b1',
 'version.packaged': '2.4.0p19',
 'version.usable_until': None}
