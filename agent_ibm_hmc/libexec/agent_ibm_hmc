while getopts 'H:U:I:' OPT; do
  case $OPT in
    H)  host=$OPTARG;;
    U)  user=$OPTARG;;
    I)  sshid=$OPTARG;;
  esac
done

sshcmd="ssh $host -l $user"
if [ -n "$sshid" ]; then
    sshcmd+=" -i $sshid"
fi

function splitcomma () {
    readarray -t $2 < <(awk -F',' '{ for( i=1; i<=NF; i++ ) print $i }' <<<"$1")
    declare -p $2
}

echo "<<<uptime>>>"
$sshcmd "cat /proc/uptime"
# echo "24779041.55 1182085577.13"

echo "<<<df>>>"
$sshcmd "monhmc -r disk -n 0"
# echo -e "Filesystem                    1K-blocks     Used Available Use% Mounted on\ndevtmpfs                       15757248        0  15757248   0% /dev\ntmpfs                          16677824       64  16677760   1% /dev/shm\ntmpfs                          16677824   363520  16314304   3% /run\ntmpfs                          16677824        0  16677824   0% /sys/fs/cgroup\n/dev/sda2                      16395220  7971100   7585672  52% /\n/dev/mapper/HMCDataVG-HomeLV   10218772   140216   9537884   2% /home\n/dev/mapper/HMCDataVG-DataLV  412642728 11707264 379947560   3% /data\n/dev/mapper/HMCDataVG-ExtraLV  20466256  3073484  16327812  16% /extra\n/dev/mapper/HMCDataVG-DumpLV  360123532  2692496 339064572   1% /dump\n/dev/sda3                       6114912  1187128   4613212  21% /var\n/dev/mapper/HMCDataVG-LogLV    20466256  4334980  15066316  23% /var/hsc/log\ntmpfs                           3335552        0   3335552   0% /run/user/601\ntmpfs                           3335552       64   3335488   1% /run/user/604\ntmpfs                           3335552        0   3335552   0% /run/user/600"

echo "<<<kernel>>>"
date +%s
$sshcmd "cat /proc/vmstat /proc/stat"
