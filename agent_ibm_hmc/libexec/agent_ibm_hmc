    ## echo -e "15,ded,null\n14,ded,null\n13,ded,null\n12,ded,null\n11,ded,null\n10,ded,null\n9,ded,null\n8,ded,null\n7,ded,null\n6,ded,null\n5,ded,null\n4,ded,null\n3,ded,null\n2,shared,1.0\n1,shared,1.0"

