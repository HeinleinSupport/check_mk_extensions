{'author': 'Robert Sander <r.sander@heinlein-support.de>',
 'description': 'Notifications via e*CityRuf pager\n'
                '\n'
                'Uses a custom user attribute named "ecityruf" for the pager '
                'number.\n'
                '\n'
                'Emails are sent directly to the MX servers of ecityruf.de\n'
                'If that fails, mail will be delivered via local MTA.\n',
 'download_url': 'https://github.com/HeinleinSupport/check_mk_extensions/',
 'files': {'cmk_addons_plugins': ['ecityruf/rulesets/ecityruf.py'],
           'notifications': ['ecityruf']},
 'name': 'ecityruf',
 'title': 'e*CityRuf Notifications',
 'version': '1.0.0',
 'version.min_required': '2.5.0b1',
 'version.packaged': '2.5.0p3',
 'version.usable_until': None}
